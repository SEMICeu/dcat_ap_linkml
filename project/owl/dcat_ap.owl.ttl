            owl:onProperty dcat:packageFormat ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dct:format ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dct:language ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dct:rights ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dcat:mediaType ],
        [ a owl:Restriction ;
