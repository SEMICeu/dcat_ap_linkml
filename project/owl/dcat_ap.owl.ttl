        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty odrl:hasPolicy ],
        [ a owl:Restriction ;
            owl:allValuesFrom dcat:DataService ;
            owl:onProperty dcat:accessService ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty dcat:spatialResolutionInMeters ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:checksum ],
        [ a owl:Restriction ;
            owl:allValuesFrom dct:LicenseDocument ;
            owl:onProperty dct:license ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dct:license ],
        [ a owl:Restriction ;
            owl:allValuesFrom dct:MediaType ;
            owl:onProperty dct:format ],
        [ a owl:Restriction ;
            owl:allValuesFrom dct:MediaType ;
            owl:onProperty dcat:mediaType ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Resource ;
            owl:onProperty dcat:downloadURL ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:nonNegativeInteger ;
            owl:onProperty dcat:byteSize ],
        [ a owl:Restriction ;
            owl:allValuesFrom odrl:Policy ;
            owl:onProperty odrl:hasPolicy ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty dcat:accessURL ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Resource ;
            owl:onProperty dcat:accessURL ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dcat:packageFormat ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dct:issued ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dcat:byteSize ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dct:title ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dct:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:checksum ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dcat:temporalResolution ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dct:license ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dcatap:availability ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcat:downloadURL ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty foaf:page ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dcat:compressFormat ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dct:conformsTo ],
        [ a owl:Restriction ;
