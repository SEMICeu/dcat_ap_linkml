            owl:onProperty odrl:hasPolicy ],
        linkml:ClassDefinition ;
    skos:definition "A specific representation of a dataset (e.g. a downloadable file or an API access)." ;
    skos:exactMatch dcat_ap:Distribution ;
    skos:inScheme dcat_ap:3.0.1 .

dcat:keyword a owl:DatatypeProperty ;
    rdfs:label "keyword" ;
    rdfs:range xsd:string ;
    skos:definition "A keyword or tag describing the resource." ;
    skos:inScheme dcat_ap:3.0.1 .

dcat:landingPage a owl:ObjectProperty ;
    rdfs:label "landingPage" ;
    rdfs:range foaf:Document ;
    skos:definition "A web page that gives access to the resource." ;
    skos:inScheme dcat_ap:3.0.1 .

dcat:spatialResolutionInMeters a owl:DatatypeProperty ;
    rdfs:label "spatialResolution" ;
    rdfs:range xsd:decimal ;
    skos:definition "Minimum spatial separation resolvable, in meters." ;
    skos:inScheme dcat_ap:3.0.1 .

dcat:theme a owl:ObjectProperty ;
    rdfs:label "theme" ;
    rdfs:range skos:Concept ;
    skos:definition "A category of the resource." ;
    skos:inScheme dcat_ap:3.0.1 .

dct:source a owl:ObjectProperty ;
    rdfs:label "source",
        "sourceMetadata" ;
    rdfs:range dcat:CatalogRecord,
        dcat:Dataset ;
    skos:definition "A related resource from which the described resource is derived.",
        "Original metadata source for the catalog record." ;
    skos:inScheme dcat_ap:3.0.1 .

vcard:Kind a owl:Class ;
    rdfs:label "Kind" ;
    rdfs:subClassOf rdfs:Resource ;
    skos:definition "A vCard Kind." ;
    skos:exactMatch dcat_ap:Kind ;
    skos:inScheme dcat_ap:3.0.1 .

dcat:Catalog a owl:Class ;
    rdfs:label "Catalogue" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcat:record ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dct:modified ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dct:license ],
        [ a owl:Restriction ;
            owl:allValuesFrom dct:PeriodOfTime ;
            owl:onProperty dct:temporal ],
        [ a owl:Restriction ;
            owl:allValuesFrom dcat:Dataset ;
            owl:onProperty dcat:dataset ],
        [ a owl:Restriction ;
            owl:allValuesFrom dct:LicenseDocument ;
            owl:onProperty dct:license ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dct:creator ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty dct:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dct:modified ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dct:language ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty dct:title ],
        [ a owl:Restriction ;
            owl:allValuesFrom dcat:DataService ;
            owl:onProperty dcat:service ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty dct:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dct:issued ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty foaf:homepage ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty foaf:homepage ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcat:themeTaxonomy ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dct:publisher ],
        [ a owl:Restriction ;
            owl:allValuesFrom dct:RightsStatement ;
            owl:onProperty dct:rights ],
        [ a owl:Restriction ;
            owl:allValuesFrom dcat:Catalog ;
            owl:onProperty dct:hasPart ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty dct:title ],
        [ a owl:Restriction ;
            owl:allValuesFrom foaf:Agent ;
            owl:onProperty dct:publisher ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty dct:publisher ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dct:hasPart ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcat:service ],
        [ a owl:Restriction ;
            owl:allValuesFrom foaf:Agent ;
            owl:onProperty dct:creator ],
        [ a owl:Restriction ;
            owl:allValuesFrom dct:LinguisticSystem ;
            owl:onProperty dct:language ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcat:dataset ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcat:catalog ],
        [ a owl:Restriction ;
            owl:allValuesFrom dct:Location ;
            owl:onProperty dct:spatial ],
        [ a owl:Restriction ;
            owl:allValuesFrom dcat:CatalogRecord ;
            owl:onProperty dcat:record ],
        [ a owl:Restriction ;
            owl:allValuesFrom dcat:Catalog ;
            owl:onProperty dcat:catalog ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dct:issued ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcatap:applicableLegislation ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:unionOf ( xsd:date xsd:dateTime xsd:gYear xsd:gYearMonth ) ] ;
            owl:onProperty dct:issued ],
        [ a owl:Restriction ;
            owl:allValuesFrom foaf:Document ;
            owl:onProperty foaf:homepage ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dct:rights ],
        [ a owl:Restriction ;
            owl:allValuesFrom skos:ConceptScheme ;
            owl:onProperty dcat:themeTaxonomy ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dct:license ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:unionOf ( xsd:date xsd:dateTime xsd:gYear xsd:gYearMonth ) ] ;
            owl:onProperty dct:modified ],
        [ a owl:Restriction ;
            owl:allValuesFrom eli:LegalResource ;
            owl:onProperty dcatap:applicableLegislation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dct:spatial ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dct:temporal ],
        dcat:Resource ;
    skos:definition "A curated collection of metadata about resources (e.g. datasets and data services in the context of a data catalogue)." ;
    skos:exactMatch dcat_ap:Catalogue ;
    skos:inScheme dcat_ap:3.0.1 .

dcat:DataService a owl:Class ;
    rdfs:label "DataService" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dct:license ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Resource ;
            owl:onProperty dcat:endpointDescription ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty dct:title ],
        [ a owl:Restriction ;
            owl:allValuesFrom dct:MediaType ;
            owl:onProperty dct:format ],
        [ a owl:Restriction ;
            owl:allValuesFrom dct:LicenseDocument ;
            owl:onProperty dct:license ],
        [ a owl:Restriction ;
            owl:allValuesFrom eli:LegalResource ;
            owl:onProperty dcatap:applicableLegislation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dct:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dct:accessRights ],
        [ a owl:Restriction ;
            owl:allValuesFrom foaf:Document ;
            owl:onProperty dcat:landingPage ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty dcat:keyword ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Resource ;
            owl:onProperty dcat:endpointURL ],
        [ a owl:Restriction ;
            owl:allValuesFrom skos:Concept ;
            owl:onProperty dcat:theme ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dct:format ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcat:servesDataset ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcat:keyword ],
        [ a owl:Restriction ;
            owl:allValuesFrom foaf:Agent ;
            owl:onProperty dct:publisher ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcat:contactPoint ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dct:publisher ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dct:conformsTo ],
        [ a owl:Restriction ;
            owl:allValuesFrom foaf:Document ;
            owl:onProperty foaf:page ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dct:accessRights ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty dct:title ],
        [ a owl:Restriction ;
            owl:allValuesFrom dct:Standard ;
            owl:onProperty dct:conformsTo ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcatap:applicableLegislation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dct:license ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcat:theme ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty foaf:page ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcat:landingPage ],
        [ a owl:Restriction ;
            owl:allValuesFrom dct:RightsStatement ;
            owl:onProperty dct:accessRights ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty dct:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcat:endpointDescription ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dct:publisher ],
        [ a owl:Restriction ;
            owl:allValuesFrom vcard:Kind ;
            owl:onProperty dcat:contactPoint ],
        [ a owl:Restriction ;
            owl:allValuesFrom dcat:Dataset ;
            owl:onProperty dcat:servesDataset ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty dcat:endpointURL ],
        dcat:Resource ;
    skos:definition "A collection of operations that provides access to one or more datasets or data processing functions." ;
    skos:exactMatch dcat_ap:DataService ;
    skos:inScheme dcat_ap:3.0.1 .

dct:LinguisticSystem a owl:Class ;
    rdfs:label "LinguisticSystem" ;
    rdfs:subClassOf rdfs:Resource ;
    skos:definition "A linguistic system (DC Terms LinguisticSystem)." ;
    skos:exactMatch dcat_ap:LinguisticSystem ;
    skos:inScheme dcat_ap:3.0.1 .

dct:Standard a owl:Class ;
    rdfs:label "Standard" ;
    rdfs:subClassOf rdfs:Resource ;
    skos:definition "A standard (DC Terms Standard)." ;
    skos:exactMatch dcat_ap:Standard ;
    skos:inScheme dcat_ap:3.0.1 .

dct:accessRights a owl:ObjectProperty ;
    rdfs:label "accessRights" ;
    rdfs:range dct:RightsStatement ;
    skos:definition "Information about who can access the resource." ;
    skos:inScheme dcat_ap:3.0.1 .

dct:accrualPeriodicity a owl:ObjectProperty ;
    rdfs:label "frequency" ;
    rdfs:range dct:Frequency ;
    skos:definition "The frequency at which the dataset is updated." ;
    skos:inScheme dcat_ap:3.0.1 .

dct:spatial a owl:ObjectProperty ;
    rdfs:label "geographicalCoverage" ;
    rdfs:range dct:Location ;
    skos:definition "The geographic coverage of the resource." ;
    skos:inScheme dcat_ap:3.0.1 .

dct:temporal a owl:ObjectProperty ;
    rdfs:label "temporalCoverage" ;
    rdfs:range dct:PeriodOfTime ;
    skos:definition "The temporal coverage of the resource." ;
    skos:inScheme dcat_ap:3.0.1 .

dct:type a owl:ObjectProperty ;
    rdfs:label "type" ;
    rdfs:range skos:Concept ;
    skos:definition "The nature or genre of the resource." ;
    skos:inScheme dcat_ap:3.0.1 .

adms:status a owl:ObjectProperty ;
    rdfs:label "changeType",
        "status" ;
    rdfs:range skos:Concept ;
    skos:definition "The status of the distribution.",
        "The type of update on the cataloged resource." ;
    skos:inScheme dcat_ap:3.0.1 .

dcat:contactPoint a owl:ObjectProperty ;
    rdfs:label "contactPoint" ;
    rdfs:range vcard:Kind ;
    skos:definition "Contact information for the resource." ;
    skos:inScheme dcat_ap:3.0.1 .

dcat:temporalResolution a owl:DatatypeProperty ;
    rdfs:label "temporalResolution" ;
    rdfs:range xsd:string ;
    skos:definition "Minimum time period resolvable in the dataset." ;
    skos:inScheme dcat_ap:3.0.1 .

foaf:page a owl:ObjectProperty ;
    rdfs:label "documentation" ;
    rdfs:range foaf:Document ;
    skos:definition "A page or document about the resource." ;
    skos:inScheme dcat_ap:3.0.1 .

eli:LegalResource a owl:Class ;
    rdfs:label "LegalResource" ;
    rdfs:subClassOf rdfs:Resource ;
    skos:definition "A legal resource (ELI)." ;
    skos:exactMatch dcat_ap:LegalResource ;
    skos:inScheme dcat_ap:3.0.1 .

dct:RightsStatement a owl:Class ;
    rdfs:label "RightsStatement" ;
    rdfs:subClassOf rdfs:Resource ;
    skos:definition "A statement about rights associated with a resource." ;
    skos:exactMatch dcat_ap:RightsStatement ;
    skos:inScheme dcat_ap:3.0.1 .

dcat:Resource a owl:Class ;
    rdfs:label "CataloguedResource" ;
    rdfs:subClassOf [ owl:unionOf ( dcat:Catalog dcat:DataService dcat:Dataset dcat:DatasetSeries ) ],
        rdfs:Resource ;
    skos:definition "Union of Catalogue, Dataset, DataService, DatasetSeries (a.k.a. dcat:Resource)." ;
    skos:exactMatch dcat_ap:CataloguedResource ;
    skos:inScheme dcat_ap:3.0.1 .

dct:conformsTo a owl:ObjectProperty ;
    rdfs:label "applicationProfile",
        "conformsTo",
        "linkedSchemas" ;
    rdfs:range dct:Standard ;
    skos:definition "A schema that the distribution conforms to.",
        "An established standard the resource conforms to.",
        "The application profile this catalogue record conforms to." ;
    skos:inScheme dcat_ap:3.0.1 .

dct:language a owl:ObjectProperty ;
    rdfs:label "language" ;
    rdfs:range dct:LinguisticSystem ;
    skos:definition "A language of the resource." ;
    skos:inScheme dcat_ap:3.0.1 .

foaf:Agent a owl:Class ;
    rdfs:label "Agent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty foaf:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom skos:Concept ;
            owl:onProperty dct:type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dct:type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty foaf:name ],
        linkml:ClassDefinition ;
    skos:definition "An agent (e.g. a person, organisation) responsible for a resource." ;
    skos:exactMatch dcat_ap:Agent ;
    skos:inScheme dcat_ap:3.0.1 .

dct:license a owl:ObjectProperty ;
    rdfs:label "licence" ;
    rdfs:range dct:LicenseDocument ;
    skos:definition "A licence under which the resource is made available." ;
    skos:inScheme dcat_ap:3.0.1 .

dcat:Dataset a owl:Class ;
    rdfs:label "Dataset" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom eli:LegalResource ;
            owl:onProperty dcatap:applicableLegislation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dct:source ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcatap:applicableLegislation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dct:modified ],
        [ a owl:Restriction ;
            owl:allValuesFrom skos:Concept ;
            owl:onProperty dcat:theme ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcat:temporalResolution ],
        [ a owl:Restriction ;
            owl:allValuesFrom prov:Attribution ;
            owl:onProperty prov:qualifiedAttribution ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty dct:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty foaf:page ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty dct:title ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dct:publisher ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty adms:identifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom dct:ProvenanceStatement ;
            owl:onProperty dct:provenance ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty dct:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom dcat:Distribution ;
            owl:onProperty dcat:distribution ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dct:publisher ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcat:inSeries ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:unionOf ( xsd:date xsd:dateTime xsd:gYear xsd:gYearMonth ) ] ;
            owl:onProperty dct:modified ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dct:provenance ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dct:isReferencedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom dcat:Relationship ;
            owl:onProperty dcat:qualifiedRelation ],
        [ a owl:Restriction ;
            owl:allValuesFrom dct:RightsStatement ;
            owl:onProperty dct:accessRights ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dct:language ],
        [ a owl:Restriction ;
            owl:allValuesFrom foaf:Agent ;
            owl:onProperty dct:publisher ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dct:type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcat:distribution ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty dcat:spatialResolutionInMeters ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcat:version ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dct:accrualPeriodicity ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dct:temporal ],
        [ a owl:Restriction ;
            owl:allValuesFrom dct:Frequency ;
            owl:onProperty dct:accrualPeriodicity ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dct:relation ],
        [ a owl:Restriction ;
            owl:allValuesFrom dct:LinguisticSystem ;
            owl:onProperty dct:language ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dct:accessRights ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcat:theme ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty adms:versionNotes ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcat:hasVersion ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:unionOf ( xsd:date xsd:dateTime xsd:gYear xsd:gYearMonth ) ] ;
            owl:onProperty dct:issued ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty dct:title ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dct:issued ],
        [ a owl:Restriction ;
            owl:allValuesFrom dct:PeriodOfTime ;
            owl:onProperty dct:temporal ],
        [ a owl:Restriction ;
            owl:allValuesFrom dcat:Dataset ;
            owl:onProperty dcat:hasVersion ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcat:landingPage ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dct:conformsTo ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Resource ;
            owl:onProperty dct:relation ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Resource ;
            owl:onProperty dct:isReferencedBy ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty adms:versionNotes ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dct:issued ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dcat:temporalResolution ],
        [ a owl:Restriction ;
            owl:allValuesFrom dcat:Dataset ;
            owl:onProperty dct:source ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty dcat:keyword ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty prov:qualifiedAttribution ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcat:keyword ],
        [ a owl:Restriction ;
            owl:allValuesFrom dct:Standard ;
            owl:onProperty dct:conformsTo ],
        [ a owl:Restriction ;
            owl:allValuesFrom dcat:DatasetSeries ;
            owl:onProperty dcat:inSeries ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty prov:wasGeneratedBy ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dct:identifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom dct:Location ;
            owl:onProperty dct:spatial ],
        [ a owl:Restriction ;
            owl:allValuesFrom vcard:Kind ;
            owl:onProperty dcat:contactPoint ],
        [ a owl:Restriction ;
            owl:allValuesFrom skos:Concept ;
            owl:onProperty dct:type ],
        [ a owl:Restriction ;
            owl:allValuesFrom prov:Activity ;
            owl:onProperty prov:wasGeneratedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom dcat:Distribution ;
            owl:onProperty adms:sample ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcat:contactPoint ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dct:creator ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dcat:version ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcat:qualifiedRelation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dct:spatial ],
        [ a owl:Restriction ;
            owl:allValuesFrom foaf:Document ;
            owl:onProperty foaf:page ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dct:accrualPeriodicity ],
        [ a owl:Restriction ;
            owl:allValuesFrom foaf:Document ;
            owl:onProperty dcat:landingPage ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty dcat:version ],
        [ a owl:Restriction ;
            owl:allValuesFrom adms:Identifier ;
            owl:onProperty adms:identifier ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty adms:sample ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcat:spatialResolutionInMeters ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dct:modified ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dct:accessRights ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty dct:identifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:duration ;
            owl:onProperty dcat:temporalResolution ],
        [ a owl:Restriction ;
            owl:allValuesFrom foaf:Agent ;
            owl:onProperty dct:creator ],
        dcat:Resource ;
    skos:definition "A collection of data, published or curated by a single agent, and available for access or download in one or more representations." ;
    skos:exactMatch dcat_ap:Dataset ;
    skos:inScheme dcat_ap:3.0.1 .

dcatap:applicableLegislation a owl:ObjectProperty ;
    rdfs:label "applicableLegislation" ;
    rdfs:range eli:LegalResource ;
    skos:definition "The legislation applicable to the resource (DCAT-AP extension)." ;
    skos:inScheme dcat_ap:3.0.1 .

dct:MediaType a owl:Class ;
    rdfs:label "MediaType" ;
    rdfs:subClassOf rdfs:Resource ;
    skos:definition "An IANA media type (DC Terms MediaType)." ;
    skos:exactMatch dcat_ap:MediaType ;
    skos:inScheme dcat_ap:3.0.1 .

foaf:Document a owl:Class ;
    rdfs:label "Document" ;
    rdfs:subClassOf rdfs:Resource ;
    skos:definition "A foaf:Document." ;
    skos:exactMatch dcat_ap:Document ;
    skos:inScheme dcat_ap:3.0.1 .

dct:description a owl:DatatypeProperty ;
    rdfs:label "description" ;
    rdfs:range xsd:string ;
    skos:definition "A free-text account of the resource." ;
    skos:inScheme dcat_ap:3.0.1 .

dct:publisher a owl:ObjectProperty ;
    rdfs:label "publisher" ;
    rdfs:range foaf:Agent ;
    skos:definition "An entity responsible for making the resource available." ;
    skos:inScheme dcat_ap:3.0.1 .

skos:Concept a owl:Class ;
    rdfs:label "Concept" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty skos:prefLabel ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty skos:prefLabel ],
        linkml:ClassDefinition ;
    skos:definition "A concept (e.g. a category, theme, keyword)." ;
    skos:exactMatch dcat_ap:Concept ;
    skos:inScheme dcat_ap:3.0.1 .

dct:title a owl:DatatypeProperty ;
    rdfs:label "title" ;
    rdfs:range xsd:string ;
    skos:definition "A name given to the resource." ;
    skos:inScheme dcat_ap:3.0.1 .

dct:issued a owl:DatatypeProperty ;
    rdfs:label "listingDate",
        "releaseDate" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:unionOf ( xsd:date xsd:dateTime xsd:gYear xsd:gYearMonth ) ],
        [ a rdfs:Datatype ;
            owl:unionOf ( xsd:date xsd:dateTime xsd:gYear xsd:gYearMonth ) ] ;
    skos:definition "The date of formal issuance of the resource. Modelled as a DateOrDateTimeDataType disjunction (xsd:date | xsd:dateTime | xsd:gYear | xsd:gYearMonth) to match DCAT-AP's DateOrDateTimeDataType_Shape.",
        "The date on which the description was listed in the catalogue. Modelled as a DateOrDateTimeDataType disjunction (xsd:date | xsd:dateTime | xsd:gYear | xsd:gYearMonth) to match DCAT-AP's DateOrDateTimeDataType_Shape." ;
    skos:inScheme dcat_ap:3.0.1 .

dct:modified a owl:DatatypeProperty ;
    rdfs:label "modificationDate" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:unionOf ( xsd:date xsd:dateTime xsd:gYear xsd:gYearMonth ) ] ;
    skos:definition "The date on which the resource was changed. Modelled as a DateOrDateTimeDataType disjunction (xsd:date | xsd:dateTime | xsd:gYear | xsd:gYearMonth) to match DCAT-AP's DateOrDateTimeDataType_Shape." ;
    skos:inScheme dcat_ap:3.0.1 .

xsd:gYear a rdfs:Datatype .

xsd:gYearMonth a rdfs:Datatype .

rdfs:Resource a owl:Class ;
    rdfs:label "Resource" ;
    rdfs:subClassOf [ owl:unionOf ( prov:Activity prov:Attribution dcat:Resource spdx:ChecksumAlgorithm foaf:Document dct:Frequency locn:Geometry vcard:Kind eli:LegalResource dct:LinguisticSystem dct:MediaType odrl:Policy dct:ProvenanceStatement dct:RightsStatement dcat:Role dct:Standard ) ],
        linkml:ClassDefinition ;
    skos:definition "Top-level abstract resource. Used as a generic node range when the DCAT-AP shape only constrains nodeKind to BlankNodeOrIRI/IRI without a specific class." ;
    skos:exactMatch dcat_ap:Resource ;
    skos:inScheme dcat_ap:3.0.1 .

dcat_ap:3.0.1 a owl:Ontology ;
    rdfs:label "dcat_ap" ;
    dct:license "CC-BY-4.0" ;
    dct:title "DCAT-AP 3.0.1 (LinkML approximation)" ;
    skos:definition "A LinkML approximation of the SEMIC DCAT-AP 3.0.1 specification. This schema captures the core classes and properties of DCAT-AP 3.0.1 as defined by the SHACL shapes at https://semiceu.github.io/DCAT-AP/releases/3.0.1/html/shacl/shapes.ttl and the JSON-LD context at https://semiceu.github.io/DCAT-AP/releases/3.0.1/context/dcat-ap.jsonld This is a SCOPING/DEMO schema, not a production specification. Some constructs (e.g. property-level disjunction shapes, sh:or with multiple datatypes, inverse paths) are not directly expressible in LinkML and are approximated or omitted." .

